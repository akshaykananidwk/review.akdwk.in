# Copy to `.env` in the project root and fill in real values.
# The `.env` file is NEVER touched by the GitHub auto-update system.

DB_HOST=127.0.0.1
DB_NAME=
DB_USER=
DB_PASSWORD=

APP_URL=https://review.akdwk.in
APP_NAME=Krishna Review System
APP_ENV=production

GAPI_API_KEY=

# 64 hex chars — required for /run_cron.php and web refill
# Generate with: openssl rand -hex 32
REFILL_CRON_SECRET=
